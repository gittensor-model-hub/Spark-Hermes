# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
.ruff_cache/
.pytest_cache/
.pyright/

# uv
uv.lock.tmp

# Data / model artifacts (large, not checked in)
data/raw/
data/processed/
data/prepared/
*.jsonl
!data/prompts/*.jsonl
!eval/data/gsm8k_regression_50.jsonl
!eval/data/gsm8k_fewshot_5.jsonl
# Hermes agent task prompts and labeled routing sets are source, not generated data —
# tracked, not ignored. Covers nested task dirs (hermes/tasks/, hermes/router/tasks/).
!hermes/**/tasks/*.jsonl
!hermes/tasks/*.jsonl
checkpoints/
outputs/
eval/results/
proof/_bundles/
*.safetensors
*.gguf
# tritonbench is vendored (see tritonbench/VENDORED.md) so evaluators and miners
# run the same harness; only its generated/derived artifacts stay ignored.
tritonbench/.venv/
tritonbench/.tmp/
tritonbench/results/
tritonbench/LLM_generated/
!tritonbench/**/*.jsonl

# runs/ledger.jsonl is the immutable proof-of-training log — tracked, not ignored
!runs/ledger.jsonl
# datasets/registry.jsonl is the immutable dataset-track registry — tracked, not ignored
!datasets/registry.jsonl

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/
.idea/

# Local scratch: status notes, working files, anything not meant to ship. Ignored rather
# than committed so a working note never has to be written as if it were documentation.
.local/

# Validator round store. Load-bearing, not housekeeping: `RoundWindow.snapshot()` carries every
# verdict, including ones recorded while a round was still FROZEN, and publishing those turns the
# withheld verifier into a check-your-guess oracle. `validator.store.store_is_private` asks git
# whether this entry is still here and refuses to construct a store if it is not.
var/

# Local agent/orchestration scaffolding. Machine-specific and not project content:
# MCP endpoints point at localhost ports, and AGENTS.md here is a symlink into .local/
# whose absolute target exists on exactly one machine -- committed once already, where it
# dangled in CI and killed `ruff format` before any test ran.
.agents/
.claude/
.codex/
.hermes/
.zenith/
AGENTS.md
.mcp.json
