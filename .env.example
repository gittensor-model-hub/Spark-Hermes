# Teacher provider credentials — copy to .env and fill in, never commit .env itself.

# Anthropic (Claude Fable 5 — `claude-fable-5`)
ANTHROPIC_API_KEY=

# Qwen 3.8 Max 2.4T (`qwen3.8-max`), served through the yunwu gateway.
YUNWU_API_KEY=
# Optional: override the gateway base URL (default https://yunwu.ai/v1).
# YUNWU_API_BASE=

# Kimi K3 (`kimi-k3`), served through OpenRouter as `moonshotai/kimi-k3`.
OPENROUTER_API_KEY=
# Optional: override the gateway base URL (default https://openrouter.ai/api/v1).
# OPENROUTER_API_BASE=

# OpenAI (GPT 5.6 — `gpt-5.6`)
# `gpt-5.6-sol` is retired for generation; bundles already proved with it still verify.
OPENAI_API_KEY=
